import json
import urllib.request

def fetch_currency_strength():
    # currencystrengthmeter.org が内部で使用しているデータエンドポイント
    url = "https://currencystrengthmeter.org/data.json"
    
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Referer": "https://currencystrengthmeter.org/"
    }
    
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req) as response:
            if response.status == 200:
                data = json.loads(response.read().decode('utf-8'))
                
                # 取得したデータを整形してJSONファイルに保存
                with open("currency_strength.json", "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=4, ensure_ascii=False)
                
                print("--- 取得成功 ---")
                print(json.dumps(data, indent=4, ensure_ascii=False))
                return data
    except Exception as e:
        print(f"取得エラー: {e}")
        return None

if __name__ == "__main__":
    fetch_currency_strength()
